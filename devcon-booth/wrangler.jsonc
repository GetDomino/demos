{
  "name": "domino-campaign",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-16",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    // As Domino hosting deploys it: files by exact path, so server/index.ts
    // can serve index.html for page URLs without a redirect to "/".
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
